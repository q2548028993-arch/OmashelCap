# ── Mode ────────────────────────────────────────────────────────────────────
# Set to true to run with simulated data (no API key needed)
USE_MOCK=true

# ── Deriv API (required when USE_MOCK=false) ─────────────────────────────────
DERIV_APP_ID=your_app_id_here
DERIV_API_TOKEN=your_api_token_here

# Trading mode: demo | real
TRADING_MODE=demo

# ── Trading config ────────────────────────────────────────────────────────────
# Symbol to trade (R_50, R_75, CRASH1000, BOOM500, etc.)
SYMBOL=R_75

# Candle granularity in seconds (60=1m, 300=5m, 900=15m, 3600=1h)
CANDLE_GRANULARITY=60

# Risk: percentage of balance per trade (0.01 = 1%)
RISK_PER_TRADE=0.01

# Minimum stake in USD
MIN_STAKE=0.35

# Maximum stake in USD (hard ceiling — never exceeded)
MAX_STAKE=10.0

# Trade duration
TRADE_DURATION=5
TRADE_DURATION_UNIT=m

# ── Circuit breakers ──────────────────────────────────────────────────────────
MAX_CONSECUTIVE_LOSSES=5
DAILY_DRAWDOWN_LIMIT=0.05

# ── Notifications (optional) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
