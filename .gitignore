# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Environment / secrets — NEVER commit these
.env
.envrc

# Database files — contain trade history, keep local only
*.db
*.sqlite3

# Logs
*.log

# uv lockfile (optional to commit — we keep it local)
uv.lock

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checkers
.mypy_cache/
.ruff_cache/

# IDEs
.idea/
.vscode/
.cursorignore

# pyenv
.python-version

# OS
.DS_Store
Thumbs.db

# Node
node_modules/

# Frontend build output
frontend/dist/
